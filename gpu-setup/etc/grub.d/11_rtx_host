#!/bin/sh
# Extra GRUB entry: the default Arch kernel and options plus module_blacklist=vfio_pci.
# vfio-pci never loads, so the RTX 4070 goes to the nvidia driver and drives its monitor;
# the Windows VM (GPU passthrough) cannot start in that boot.
# Generated by grub-mkconfig, which exports the GRUB_* variables used below.
set -e

ucode=""
[ -f /boot/intel-ucode.img ] && ucode="/intel-ucode.img "

cat <<EOF
menuentry 'Arch Linux (RTX for host, no VM passthrough)' --class arch --class gnu-linux --class gnu --class os {
	load_video
	set gfxpayload=keep
	insmod gzio
	insmod part_gpt
	insmod fat
	search --no-floppy --fs-uuid --set=root ${GRUB_DEVICE_BOOT_UUID}
	echo	'Loading Linux linux (RTX for host) ...'
	linux	/vmlinuz-linux root=UUID=${GRUB_DEVICE_UUID} rw ${GRUB_CMDLINE_LINUX} ${GRUB_CMDLINE_LINUX_DEFAULT} module_blacklist=vfio_pci
	echo	'Loading initial ramdisk ...'
	initrd	${ucode}/initramfs-linux.img
}
EOF
