[global]
    # Powiadomienia na monitorze z fokusem
    follow = mouse
    width = (300, 400)
    origin = top-right
    offset = (16, 52)
    notification_limit = 5
    gap_size = 8
    padding = 12
    horizontal_padding = 16
    frame_width = 2
    corner_radius = 12
    font = JetBrainsMono Nerd Font 11
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    icon_position = left
    max_icon_size = 48
    icon_theme = "Papirus-Dark"
    enable_recursive_icon_lookup = true
    dmenu = /usr/bin/wofi --dmenu
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# dark-volcanic (Tern/omp): crater #1A100E (z alfą), text #ebdfd8, akcent magma #FF7A3D
[urgency_low]
    background = "#1A100Eee"
    foreground = "#8F7D74"
    frame_color = "#3A201C"
    highlight = "#4FC48A"
    timeout = 5

[urgency_normal]
    background = "#1A100Eee"
    foreground = "#ebdfd8"
    frame_color = "#FF7A3D"
    highlight = "#FF7A3D, #F3C24F"
    timeout = 8

[urgency_critical]
    background = "#1A100Eee"
    foreground = "#ebdfd8"
    frame_color = "#FF5C5C"
    highlight = "#FF5C5C"
    timeout = 0
